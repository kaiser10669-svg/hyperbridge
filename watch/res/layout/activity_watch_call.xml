<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/bg_black"
    android:padding="36dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ВХОДЯЩИЙ ВЫЗОВ"
        android:textColor="@color/neon_green"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.1" />

    <TextView
        android:id="@+id/tvCallerName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Имя контакта"
        android:textColor="@color/text_white"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginTop="12dp"
        android:gravity="center" />

    <TextView
        android:id="@+id/tvCallerNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="+7 (999) 000-00-00"
        android:textColor="@color/text_muted"
        android:textSize="13sp"
        android:layout_marginTop="4dp"
        android:gravity="center" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="24dp">

        <Button
            android:id="@+id/btnRejectCall"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:text="✕"
            android:textColor="@color/text_white"
            android:textSize="24sp"
            android:textStyle="bold"
            android:background="@drawable/bg_card"
            android:layout_marginEnd="16dp" />

        <Button
            android:id="@+id/btnAcceptCall"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:text="📞"
            android:textColor="@color/text_white"
            android:textSize="22sp"
            android:background="@drawable/btn_cyan"
            android:layout_marginStart="16dp" />
    </LinearLayout>

</LinearLayout>
