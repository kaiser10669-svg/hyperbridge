<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_black"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="36dp"
        android:paddingEnd="36dp"
        android:paddingTop="48dp"
        android:paddingBottom="56dp">

        <TextView
            android:id="@+id/tvAppTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HYPERBRIDGE"
            android:textColor="@color/neon_cyan"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● ПОДКЛЮЧЕНО"
            android:textColor="@color/neon_green"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/badge_status"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_marginTop="8dp" />

        <!-- Dual Device Battery Pod -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_card"
            android:padding="12dp"
            android:layout_marginTop="14dp">

            <!-- Phone Battery -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📱 Vivo"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tvPhoneBattery"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--%"
                    android:textColor="@color/text_white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="#222D42" />

            <!-- Watch Battery -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⌚ Watch"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tvWatchSelfBattery"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="37%"
                    android:textColor="@color/neon_cyan"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Live Health Pod -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/card_health"
            android:padding="12dp"
            android:layout_marginTop="10dp">

            <!-- Pulse -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="❤️ Пульс"
                    android:textColor="@color/neon_red"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tvWatchHeartRate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="74"
                    android:textColor="@color/text_white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="#222D42" />

            <!-- Steps -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👟 Шаги"
                    android:textColor="@color/neon_cyan"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tvWatchSteps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="6,482"
                    android:textColor="@color/text_white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Action Buttons -->
        <Button
            android:id="@+id/btnTestVibrate"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="🔔 Тест тактильности"
            android:textColor="@color/text_white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/btn_cyan"
            android:layout_marginTop="14dp" />

        <Button
            android:id="@+id/btnFindPhone"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="📱 Найти телефон"
            android:textColor="@color/text_white"
            android:textSize="12sp"
            android:background="@drawable/btn_action"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/tvLastMsg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Синхронизация активна"
            android:textColor="@color/text_muted"
            android:textSize="10sp"
            android:layout_marginTop="12dp"
            android:gravity="center" />

    </LinearLayout>
</ScrollView>
