                android:textSize="13sp"
                android:checked="true" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#162236" />

            <Switch
                android:id="@+id/swWhatsApp"
                android:layout_width="match_parent"
                android:layout_height="54dp"
