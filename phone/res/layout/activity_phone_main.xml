                android:textSize="13sp"
                android:checked="true" />
        </LinearLayout>

        <!-- ==================== DIAGNOSTIC TRIGGERS ==================== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ПРОВЕРКА И ТЕСТИРОВАНИЕ СВЯЗИ"
            android:textColor="@color/text_secondary"
